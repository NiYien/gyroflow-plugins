    "app.error.fcpxml.ambiguous_package": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The .fcpxmld package must contain exactly one root Info.fcpxml."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".fcpxmld パッケージのルートには Info.fcpxml が 1 つだけ必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ".fcpxmld 패키지 루트에는 Info.fcpxml이 정확히 하나 있어야 합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакет .fcpxmld должен содержать ровно один файл Info.fcpxml в корне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": ".fcpxmld 包的根目录必须只包含一个 Info.fcpxml。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": ".fcpxmld 套件的根目錄必須只包含一個 Info.fcpxml。"
          }
        }
      }
    },
    "app.error.fcpxml.invalid_file": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected FCPXML is not a regular readable file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した FCPXML は読み取り可能な通常ファイルではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 FCPXML은 읽을 수 있는 일반 파일이 아닙니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранный FCPXML не является доступным для чтения обычным файлом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选 FCPXML 不是可读取的普通文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選 FCPXML 不是可讀取的一般檔案。"
          }
        }
      }
    },
    "app.error.fcpxml.symbolic_link": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbolic-link FCPXML inputs are not accepted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シンボリックリンクの FCPXML 入力は使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심볼릭 링크 FCPXML 입력은 허용되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "FCPXML по символической ссылке не принимается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不接受符号链接形式的 FCPXML 输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不接受符號連結形式的 FCPXML 輸入。"
          }
        }
      }
    },
    "app.error.fcpxml.too_large": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected FCPXML exceeds the supported size limit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した FCPXML は対応サイズを超えています。"
          }
        },
        "ko": {
