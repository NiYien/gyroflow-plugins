    "app.panel.save_replacement": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a separate replacement FCPXML. The internal project name is unchanged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "置き換え用 FCPXML を別名で保存します。内部プロジェクト名は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별도의 대치 FCPXML을 저장합니다. 내부 프로젝트 이름은 변경되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните отдельный FCPXML для замены. Внутреннее имя проекта не изменится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
