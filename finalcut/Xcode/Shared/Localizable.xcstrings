    "app.accessibility.next_step": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next step: import the saved FCPXML in Final Cut Pro, then choose Replace."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の手順：保存した FCPXML を Final Cut Pro に読み込み、システムダイアログで「置き換える」を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 단계: 저장한 FCPXML을 Final Cut Pro로 가져온 다음 시스템 대화상자에서 대치를 선택하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Далее: импортируйте сохранённый FCPXML в Final Cut Pro и выберите «Заменить» в системном диалоге."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一步：在 Final Cut Pro 中导入保存的 FCPXML，然后在系统对话框中选择“替换”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下一步：在 Final Cut Pro 中匯入儲存的 FCPXML，然後在系統對話框中選擇「取代」。"
          }
        }
      }
    },
