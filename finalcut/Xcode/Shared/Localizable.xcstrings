    "effect.inspector.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load a .gyroflow project. Complex edits should be made in Gyroflow, then loaded here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".gyroflow プロジェクトを読み込みます。複雑な編集は Gyroflow で行い、ここで再読み込みしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ".gyroflow 프로젝트를 불러옵니다. 복잡한 편집은 Gyroflow에서 수행한 후 여기에서 다시 불러오십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузите проект .gyroflow. Сложное редактирование следует выполнять в Gyroflow, а затем загрузить проект здесь снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载 .gyroflow 项目。复杂编辑应在 Gyroflow 中完成，然后在此重新加载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "載入 .gyroflow 專案。複雜編輯應在 Gyroflow 中完成，然後在此重新載入。"
          }
        }
      }
