    "app.about.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Batch project processing for Final Cut Pro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Final Cut Pro のプロジェクトを一括処理"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Final Cut Pro 프로젝트 일괄 처리"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакетная обработка проектов Final Cut Pro"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Final Cut Pro 批量项目处理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Final Cut Pro 批次專案處理"
          }
        }
      }
    },
