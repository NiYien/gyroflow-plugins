    "app.replace.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Final Cut Pro, import the saved FCPXML and choose Replace in the native dialog."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した FCPXML を Final Cut Pro に読み込み、システムダイアログで「置き換える」を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 FCPXML을 Final Cut Pro로 가져오고 시스템 대화상자에서 대치를 선택하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортируйте сохранённый FCPXML в Final Cut Pro и выберите «Заменить» в системном диалоге."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Final Cut Pro 中导入保存的 FCPXML，并在系统对话框中选择“替换”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Final Cut Pro 中匯入儲存的 FCPXML，並在系統對話框中選擇「取代」。"
          }
        }
      }
    },
    "app.replace.unconfirmed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Final Cut, choose Replace for the project with the same name. This app cannot tell whether you chose Replace, Keep Both, or Cancel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Final Cut で同名プロジェクトの「置き換える」を選択してください。このアプリは、「置き換える」「両方を保持」「キャンセル」のどれを選んだか確認できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Final Cut에서 동명 프로젝트의 대치를 선택하십시오. 이 앱은 대치, 둘 다 유지 또는 취소 중 무엇을 선택했는지 확인할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Final Cut выберите «Заменить» для одноимённого проекта. Приложение не может определить, выбрали ли вы «Заменить», «Сохранить оба» или «Отмена»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Final Cut 中对同名项目选择“替换”。本应用无法判断你最终选择了“替换”“两者都保留”还是“取消”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 Final Cut 中對同名專案選擇「取代」。本 App 無法判斷你最終選擇了「取代」、「兩者都保留」或「取消」。"
          }
        }
      }
    },
