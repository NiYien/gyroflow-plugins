    "effect.action.browse_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load a .gyroflow project. Complex edits can be prepared in Gyroflow and imported here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".gyroflow プロジェクトを読み込みます。複雑な編集は Gyroflow で準備してからここで読み込めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ".gyroflow 프로젝트를 불러옵니다. 복잡한 편집은 Gyroflow에서 준비한 뒤 여기로 가져올 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузите проект .gyroflow. Сложное редактирование можно подготовить в Gyroflow и затем импортировать здесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载 .gyroflow 项目。复杂编辑可在 Gyroflow 中准备后在此导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "載入 .gyroflow 專案。複雜編輯可在 Gyroflow 中準備後於此匯入。"
          }
        }
      }
    },
